# Answer Sheet Evaluator - Environment Configuration Template
# Copy this file to .env and fill in your values.

# --- General ---
DEBUG=false
LOG_LEVEL=INFO

# --- OpenAI API Configuration ---
# Enter your OpenAI API key here
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_VISION_MODEL=gpt-4o
OPENAI_EVAL_MODEL=gpt-4o

# --- OCR Provider ---
# "openai" uses OpenAI Vision as the primary OCR engine with automatic TrOCR fallback
# "trocr" uses local Microsoft TrOCR
OCR_PROVIDER=openai

# --- Semantic Evaluation Provider ---
# "openai" uses OpenAI GPT models with automatic fallback to local Sentence-Transformer
# "local" runs 100% offline using the local Sentence-Transformer model
LLM_PROVIDER=openai

# --- Local Fallback Models ---
TROCR_MODEL_NAME=microsoft/trocr-base-handwritten
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# --- Device ---
# "auto" selects CUDA if available, else CPU
DEVICE=auto

# --- Image Preprocessing ---
PREPROCESS_GRAYSCALE=true
PREPROCESS_DENOISE=true
PREPROCESS_CONTRAST=true
PREPROCESS_THRESHOLD=false
PREPROCESS_DESKEW=true

# --- Confidence Thresholds ---
CONFIDENCE_HIGH_THRESHOLD=0.75
CONFIDENCE_LOW_THRESHOLD=0.45

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
